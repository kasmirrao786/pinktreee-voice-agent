# Postgres connection string (Railway Postgres works out of the box)
DATABASE_URL="postgresql://user:password@localhost:5432/pinktree?schema=public"

# Session cookie signing secret (32+ random chars). Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32-plus-character-secret"

# AES-256-GCM master key for encrypting telephony provider credentials.
# Must be a 32-byte key, base64-encoded. Generate with: openssl rand -base64 32
# NEVER commit a real value here. If your host offers a cheap KMS (AWS KMS / GCP KMS)
# at deploy time, wrap this key with it instead of storing it as a bare env var.
CREDENTIAL_ENCRYPTION_KEY="replace-with-a-base64-32-byte-key"
CREDENTIAL_ENCRYPTION_KEY_VERSION="1"

# ---- Calling-engine (Project 1) integration --------------------------------
# Base URL of the calling-engine service - campaigns.ts calls
# {CALLING_ENGINE_URL}/tenants/:tenantId/campaigns/:id/start|pause|stop to
# actually start/stop dialing.
CALLING_ENGINE_URL=        # e.g. http://calling-engine-internal-host:3000

# knowledge.ts POSTs {sourceId, tenantId, agentId} here when a knowledge
# source is created/edited - point this at the calling-engine's /ingest
# route (same host as CALLING_ENGINE_URL, that specific path).
INGESTION_ENDPOINT_URL=    # e.g. http://calling-engine-internal-host:3000/ingest

# ---- Call intelligence pipeline (formerly a separate "intelligence-service") ----
# Folded into this project - see root README's "Restructuring: three
# services down to two" for why. These were previously that standalone
# service's own env vars; same names, same meaning, just configured here now.

# Verifies calling-engine's signed call.ended webhook
# (src/app/api/webhooks/call-events/route.ts). MUST be the exact same value
# as calling-engine's CALL_EVENTS_WEBHOOK_SECRET.
CALL_EVENTS_WEBHOOK_SECRET=

# LLM for call summarization/outcome/sentiment/qualification extraction
# (OpenAI-compatible chat completions via OpenRouter).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Calendar provider for appointment booking. "mock" works with zero setup
# (bookings are real Appointment rows, just not synced to any real external
# calendar). "google" requires a service-account JSON path - a tenant opts
# into it via a TenantCalendarConfig row (no settings UI writes this yet,
# a known gap - see root README).
CALENDAR_PROVIDER=mock
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
