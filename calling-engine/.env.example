# Telephony provider - you do NOT need to fill these in for a *multi-tenant*
# deployment. Once Project 2's saas-platform is wired up, each tenant's
# Twilio/Telnyx credentials come from the shared `provider_credentials`
# table (Settings > Telephony in the dashboard), not from here. TWILIO_*/
# TELNYX_* below are read only as a fallback for the bootstrap "Default"
# tenant this service creates on first boot with no saas-platform running
# yet (e.g. testing this service standalone) - leave blank once the
# dashboard is your source of truth.

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=      # e.g. +1415XXXXXXX (must be a Twilio-purchased number)

# Telnyx
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=     # Call Control App ID - the app's webhook URL doesn't need to be set there, we pass webhook_url per-call
TELNYX_PHONE_NUMBER=      # e.g. +1415XXXXXXX (must be a Telnyx-purchased number assigned to the Call Control App above)
TELNYX_PUBLIC_KEY=        # From Mission Control Portal > Account Settings > Public Key - verifies incoming webhooks are genuinely from Telnyx. Account-level (not per-connection), so this stays an env var rather than moving into the admin panel with the other Telnyx settings.

# STT/TTS - self-hosted, no Deepgram by default. Configure Kokoro (TTS) and
# your chosen open-source STT server from the admin panel's Settings >
# Voice section; DEEPGRAM_API_KEY below is optional and only needed if you
# choose Deepgram as a fallback/alternative provider from that same panel.
DEEPGRAM_API_KEY=
KOKORO_TTS_URL=            # e.g. http://kokoro-internal-host:8880 - self-hosted Kokoro-FastAPI (OpenAI-compatible /v1/audio/speech)

# Embeddings for the knowledge base (RAG) - also self-hosted,
# OpenAI-compatible, same pattern as Kokoro above. Without this set,
# POST /ingest (and therefore Project 2's knowledge-base upload flow)
# returns a clear error instead of silently storing garbage vectors.
EMBEDDING_SERVICE_URL=     # e.g. http://embeddings-internal-host:8080 - text-embeddings-inference, LocalAI, or Ollama's OpenAI-compat endpoint
EMBEDDING_MODEL=all-MiniLM-L6-v2   # must produce 384-dim vectors to match the schema's vector(384) column

# OpenRouter (LLM brain - OpenAI-compatible chat completions)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5   # any OpenRouter model id works

# Storage (legacy flat-file fallback) - only used when DATABASE_URL below
# is unset, or for the parts of the single-tenant admin panel that haven't
# moved onto Postgres (contacts.json, campaign_state.json, request logs).
DATA_DIR=./data

# ---- Shared platform integration -------------------------------------------
# Postgres - THE SAME DATABASE_URL as saas-platform's .env. This service
# does NOT run its own schema migration for tenants/agents/phone_numbers/
# leads/campaigns/calls/appointments/knowledge_*/provider_credentials - run
# saas-platform's `npm run db:push` FIRST, then `node db/migrate.js` here
# (which only adds the one table this service owns: dnc_numbers).
DATABASE_URL=             # e.g. postgres://user:pass@postgres-internal-host:5432/dbname
PGSSLMODE=                # leave blank for an internal/same-network Postgres; set to "require" for a managed external Postgres that needs TLS

# MUST be the exact same value as saas-platform's CREDENTIAL_ENCRYPTION_KEY -
# this service decrypts provider credentials that saas-platform encrypted.
# Generate with `openssl rand -base64 32`. Falls back to a loud runtime
# error (not plaintext) if unset - unlike some other optional keys here,
# there's no safe insecure default for this one.
CREDENTIAL_ENCRYPTION_KEY=

# Where saas-platform is running - this service POSTs a signed call.ended
# webhook there after every call (was a separate "intelligence-service"
# before the two were merged - see root README).
SAAS_PLATFORM_URL=  # e.g. http://saas-platform-internal-host:3000
# MUST be the exact same value as saas-platform's
# CALL_EVENTS_WEBHOOK_SECRET - signs the call.ended webhook so it
# can verify it actually came from this service.
CALL_EVENTS_WEBHOOK_SECRET=

# Compliance / rate limiting
CALL_HOURS_TZ=America/New_York
CALL_HOURS_START=9         # 24h local time
CALL_HOURS_END=20          # 24h local time
MAX_CONCURRENT_CALLS=5

# Server
PORT=3000
PUBLIC_HOSTNAME=          # e.g. your-ngrok-subdomain.ngrok-free.app or your deployed domain (no https://, no trailing slash)
